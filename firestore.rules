rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // 1. TRUSTED AUTHENTICATION & ROLE VERIFICATION
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Role verification strictly relies on server-minted Custom Claims
    // or verified, protected Firestore user documents.
    // Client-side self-elevation is strictly impossible.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('role', '') == 'admin' ||
        request.auth.token.get('admin', false) == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
        )
      );
    }

    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.get('role', '') == 'staff' ||
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'staff'
        )
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Staff permission scoped strictly to their assigned department or explicit assignment
    function isStaffForComplaint() {
      let dept = request.auth.token.get('department', '');
      let staffDept = (dept != '') ? dept : (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('department', '') : ''
      );
      return isStaff() && (
        isAdmin() ||
        (staffDept != '' && staffDept == resource.data.get('department', '')) ||
        (resource.data.get('assignedStaffUid', '') != '' && resource.data.get('assignedStaffUid', '') == request.auth.uid) ||
        (resource.data.get('assignedStaffId', '') != '' && resource.data.get('assignedStaffId', '') == request.auth.uid) ||
        (resource.data.get('assignedStaffId', '') != '' && resource.data.get('assignedStaffId', '') == request.auth.token.get('staffId', ''))
      );
    }

    // Validates that student-submitted feedback has correct structure and caller UID
    function isValidStudentFeedback() {
      let f = request.resource.data.feedback;
      return f.keys().hasOnly(['rating', 'comment', 'submittedAt', 'submittedByUid']) &&
             f.get('submittedByUid', request.auth.uid) == request.auth.uid &&
             (f.get('rating', 5) is int && f.get('rating', 5) >= 1 && f.get('rating', 5) <= 5);
    }

    // Validates that student notifications are strictly legitimate and cannot spoof arbitrary recipients
    function isLegitimateStudentNotification() {
      let d = request.resource.data;
      // Case 1: Student generating a self-notification
      let isSelfNotification = (
        (d.get('recipientUid', '') == request.auth.uid || d.get('userId', '') == request.auth.uid) &&
        d.get('senderUid', '') == request.auth.uid &&
        d.get('userRole', '') == 'student'
      );
      // Case 2: Student alerting Admin regarding their own verified existing complaint
      let isAdminAlert = (
        d.get('userRole', '') == 'admin' &&
        (d.get('recipientUid', '') in ['admin', 'adm-01'] || d.get('userId', '') in ['admin', 'adm-01']) &&
        d.get('senderUid', '') == request.auth.uid &&
        'complaintId' in d &&
        exists(/databases/$(database)/documents/complaints/$(d.complaintId)) &&
        get(/databases/$(database)/documents/complaints/$(d.complaintId)).data.get('studentUid', '') == request.auth.uid
      );
      return (isSelfNotification || isAdminAlert) &&
             d.keys().hasOnly(['id', 'userId', 'recipientUid', 'senderUid', 'userRole', 'title', 'message', 'complaintId', 'trackingId', 'timestamp', 'isRead']) &&
             d.get('isRead', true) == false;
    }

    // ===============================================================
    // 2. USERS COLLECTION (Profile Management)
    // ===============================================================
    match /users/{userId} {
      // Students can read their own profile; Admin can read all; Staff can read students; Staff directory is public
      allow read: if isAuthenticated() && (
        isOwner(userId) ||
        isAdmin() ||
        (isStaff() && resource.data.get('role', '') == 'student') ||
        resource.data.get('role', '') == 'staff'
      );

      // Self-registration: Regular users can only create role='student'
      // Staff and Admin accounts can ONLY be created by Administrators
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          isOwner(userId) &&
          request.resource.data.get('role', 'student') == 'student' &&
          request.resource.data.email == request.auth.token.email &&
          !request.resource.data.keys().hasAny(['staffId', 'adminId', 'isAdmin', 'isStaff', 'roleChange'])
        )
      );

      // Updates: Users cannot alter sensitive fields (role, studentId, staffId, adminId, email)
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          isOwner(userId) &&
          request.resource.data.get('role', '') == resource.data.get('role', '') &&
          request.resource.data.email == resource.data.email &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'studentId', 'staffId', 'adminId', 'email'
          ])
        )
      );

      allow delete: if isAdmin();
    }

    // ===============================================================
    // 3. COMPLAINTS COLLECTION
    // ===============================================================
    match /complaints/{complaintId} {
      // READ PERMISSIONS:
      // - Admins can read all complaints.
      // - The complaint creator (studentUid == request.auth.uid) can read their own complaints.
      // - Staff can ONLY read complaints if they belong to the complaint's department or are assigned to it.
      // - Confidential complaints are strictly restricted to Admin, the creator student, and assigned department staff.
      // - Public complaints (isPublic == true AND isConfidential == false) are viewable across campus.
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.get('studentUid', '') == request.auth.uid) ||
        isStaffForComplaint() ||
        (resource.data.get('isPublic', false) == true && resource.data.get('isConfidential', false) == false)
      );

      // CREATE: Student identity is verified strictly using authenticated Firebase UID (studentUid == request.auth.uid)
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.get('studentUid', '') == request.auth.uid &&
          request.resource.data.status == 'Submitted' &&
          request.resource.data.studentEmail == request.auth.token.email
        )
      );

      // UPDATES: Partitioned strictly by role, department assignment, and immutable history
      allow update: if isAuthenticated() && (
        // A. Admin has complete workflow authority
        isAdmin() ||

        // B. Department Staff: Restricted to complaints in their department or explicitly assigned to them
        (
          isStaffForComplaint() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'remarks', 'resolvedDate', 'assignedStaffId', 'assignedStaffName', 'assignedStaffUid', 'history', 'updatedAt'
          ]) &&
          request.resource.data.status in ['Under Review', 'In Progress', 'Resolved', 'Rejected'] &&
          request.resource.data.get('history', []).hasAll(resource.data.get('history', [])) &&
          request.resource.data.get('history', []).size() == resource.data.get('history', []).size() + 1
        ) ||

        // C. Complaint Owner (Student) - Case 1: Submitting validated feedback on resolved complaint
        (
          resource.data.get('studentUid', '') == request.auth.uid &&
          resource.data.get('status', '') == 'Resolved' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedback', 'updatedAt']) &&
          isValidStudentFeedback()
        ) ||

        // C. Complaint Owner (Student) - Case 2: Reopening a resolved complaint (History is strictly append-only)
        (
          resource.data.get('studentUid', '') == request.auth.uid &&
          resource.data.get('status', '') == 'Resolved' &&
          request.resource.data.status == 'Reopened' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'remarks', 'resolvedDate', 'history', 'updatedAt'
          ]) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'studentUid', 'studentId', 'studentEmail', 'trackingId', 'category', 'department', 
            'title', 'description', 'priority', 'submissionDate', 'assignedStaffId', 'assignedStaffName', 'assignedStaffUid', 'evidenceImage'
          ]) &&
          // Integrity: Student cannot modify or delete any past history entry, only append exactly one new entry
          request.resource.data.get('history', []).hasAll(resource.data.get('history', [])) &&
          request.resource.data.get('history', []).size() == resource.data.get('history', []).size() + 1
        ) ||

        // D. Public Upvoting/Downvoting: Changes ONLY the authenticated user's own vote
        (
          resource.data.get('isPublic', false) == true &&
          resource.data.get('isConfidential', false) == false &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'upvotedBy', 'updatedAt']) &&
          (
            // Upvote: Caller UID was not present, is now added, size +1, upvotes +1
            (
              !resource.data.get('upvotedBy', []).hasAny([request.auth.uid]) &&
              request.resource.data.get('upvotedBy', []).hasAny([request.auth.uid]) &&
              request.resource.data.get('upvotedBy', []).hasAll(resource.data.get('upvotedBy', [])) &&
              request.resource.data.get('upvotedBy', []).size() == resource.data.get('upvotedBy', []).size() + 1 &&
              request.resource.data.get('upvotes', 0) == resource.data.get('upvotes', 0) + 1
            ) ||
            // Downvote (Undo): Caller UID was present, is now removed, size -1, upvotes -1
            (
              resource.data.get('upvotedBy', []).hasAny([request.auth.uid]) &&
              !request.resource.data.upvotedBy.hasAny([request.auth.uid]) &&
              resource.data.get('upvotedBy', []).hasAll(request.resource.data.get('upvotedBy', [])) &&
              request.resource.data.get('upvotedBy', []).size() == resource.data.get('upvotedBy', []).size() - 1 &&
              request.resource.data.get('upvotes', 0) == resource.data.get('upvotes', 0) - 1
            )
          )
        )
      );

      allow delete: if isAdmin();
    }

    // ===============================================================
    // 4. ATTENDANCE SESSIONS
    // ===============================================================
    match /attendance_sessions/{sessionId} {
      allow read: if isAuthenticated();

      // SECURITY ENFORCEMENT: Students CANNOT write to attendance sessions from client.
      // Sessions are created and managed strictly by faculty/staff and admin.
      allow create, update, delete: if isStaff() || isAdmin();
    }

    // ===============================================================
    // 5. STUDENT ATTENDANCE RECORDS (Anti-Forgery Hardening)
    // ===============================================================
    match /student_attendance/{recordId} {
      // Students can only view their own verified attendance records; Staff/Admin can view all
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isStaff() ||
        resource.data.get('studentUid', '') == request.auth.uid
      );

      // SECURITY ENFORCEMENT: Students CANNOT create or modify attendance records directly from client.
      // Official attendance records must be generated via trusted Cloud Functions (Admin SDK)
      // or recorded directly by authorized faculty/staff/admin.
      allow create, update: if isStaff() || isAdmin();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // 6. MASTER DATA (Categories & Departments)
    // ===============================================================
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ===============================================================
    // 7. NOTIFICATIONS COLLECTION
    // ===============================================================
    match /notifications/{notificationId} {
      // Read: Limited to intended recipient or admin. Staff cannot read other staff notifications.
      allow read: if isAuthenticated() && (
        resource.data.get('recipientUid', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid ||
        isAdmin()
      );

      // Creation: Staff/Admin can notify; Students can ONLY notify 'admin' or themselves regarding their verified complaint
      allow create: if isAuthenticated() && (
        isAdmin() ||
        isStaff() ||
        isLegitimateStudentNotification()
      );

      // Update: Recipients can ONLY toggle 'isRead' to true/false
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          (resource.data.get('recipientUid', '') == request.auth.uid || resource.data.get('userId', '') == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt']) &&
          request.resource.data.isRead is bool
        )
      );

      allow delete: if isAdmin();
    }
  }
}
