rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // 1. TRUSTED AUTHENTICATION & ROLE VERIFICATION
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Role verification strictly relies on server-minted Firebase Custom Claims.
    // Client-editable Firestore documents are completely untrusted for authorization.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.role == 'staff' ||
        isAdmin()
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Staff permission scoped strictly to their assigned department or explicit assignment
    function isStaffForComplaint() {
      return isStaff() && (
        isAdmin() ||
        (request.auth.token.get('department', '') == resource.data.get('department', '')) ||
        (resource.data.get('assignedStaffUid', '') == request.auth.uid) ||
        (resource.data.get('assignedStaffId', '') == request.auth.uid) ||
        (resource.data.get('assignedStaffId', '') == request.auth.token.get('staffId', ''))
      );
    }

    // Validates that student notifications are strictly legitimate and cannot spoof arbitrary recipients
    function isLegitimateStudentNotification() {
      let d = request.resource.data;
      // Case 1: Student generating a self-notification
      let isSelfNotification = (d.userId == request.auth.uid && d.userRole == 'student');
      // Case 2: Student alerting Admin regarding their own existing complaint
      let isAdminAlert = (
        d.userRole == 'admin' &&
        d.userId in ['admin', 'adm-01'] &&
        'complaintId' in d &&
        exists(/databases/$(database)/documents/complaints/$(d.complaintId)) &&
        (
          get(/databases/$(database)/documents/complaints/$(d.complaintId)).data.get('studentUid', '') == request.auth.uid ||
          get(/databases/$(database)/documents/complaints/$(d.complaintId)).data.get('studentId', '') == request.auth.uid
        )
      );
      return (isSelfNotification || isAdminAlert) &&
             d.keys().hasOnly(['id', 'userId', 'userRole', 'title', 'message', 'complaintId', 'trackingId', 'timestamp', 'isRead']) &&
             d.isRead == false;
    }

    // ===============================================================
    // 2. USERS COLLECTION (Profile Management)
    // ===============================================================
    match /users/{userId} {
      // Students can read their own profile; Staff/Admin can read all; Staff directory is public
      allow read: if isAuthenticated() && (
        isOwner(userId) ||
        isStaff() ||
        resource.data.get('role', '') == 'staff'
      );

      // Self-registration: Regular users can only create role='student'
      // Custom claim creation/promotion is strictly reserved for Admin SDK
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          isOwner(userId) &&
          request.resource.data.get('role', 'student') == 'student' &&
          request.resource.data.email == request.auth.token.email &&
          !request.resource.data.keys().hasAny(['staffId', 'adminId', 'isAdmin', 'isStaff'])
        )
      );

      // Updates: Users cannot alter sensitive fields (role, studentId, staffId, adminId, email)
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          isOwner(userId) &&
          request.resource.data.get('role', '') == resource.data.get('role', '') &&
          request.resource.data.email == resource.data.email &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'studentId', 'staffId', 'adminId', 'email'
          ])
        )
      );

      allow delete: if isAdmin();
    }

    // ===============================================================
    // 3. COMPLAINTS COLLECTION
    // ===============================================================
    match /complaints/{complaintId} {
      // Read: Public/non-confidential complaints are viewable across campus.
      // Confidential complaints are restricted to the verified owner UID, assigned staff, and admin.
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isStaff() ||
        resource.data.get('studentUid', '') == request.auth.uid ||
        resource.data.get('studentId', '') == request.auth.uid ||
        resource.data.get('isConfidential', false) == false ||
        resource.data.get('isPublic', false) == true
      );

      // Create: Student identity is verified strictly using authenticated Firebase UID (request.auth.uid)
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          (request.resource.data.get('studentUid', '') == request.auth.uid || request.resource.data.get('studentId', '') == request.auth.uid) &&
          request.resource.data.status == 'Submitted' &&
          request.resource.data.studentEmail == request.auth.token.email
        )
      );

      // Updates: Partitioned strictly by role and department assignment
      allow update: if isAuthenticated() && (
        // A. Admin has complete workflow authority
        isAdmin() ||

        // B. Department Staff: Restricted to complaints in their department or explicitly assigned to them
        (
          isStaffForComplaint() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'remarks', 'resolvedDate', 'assignedStaffId', 'assignedStaffName', 'history', 'updatedAt'
          ]) &&
          request.resource.data.status in ['Under Review', 'In Progress', 'Resolved', 'Rejected']
        ) ||

        // C. Complaint Owner (Student) - Case 1: Submitting feedback on resolved complaint
        (
          (resource.data.get('studentUid', '') == request.auth.uid || resource.data.get('studentId', '') == request.auth.uid) &&
          resource.data.status == 'Resolved' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedback', 'comments', 'updatedAt'])
        ) ||

        // C. Complaint Owner (Student) - Case 2: Reopening a resolved complaint
        (
          (resource.data.get('studentUid', '') == request.auth.uid || resource.data.get('studentId', '') == request.auth.uid) &&
          resource.data.status == 'Resolved' &&
          request.resource.data.status == 'Reopened' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'remarks', 'resolvedDate', 'history', 'updatedAt'
          ]) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'studentUid', 'studentId', 'studentEmail', 'trackingId', 'category', 'department', 
            'title', 'description', 'priority', 'submissionDate', 'assignedStaffId', 'assignedStaffName', 'evidenceImage'
          ])
        ) ||

        // D. Public Upvoting/Downvoting: Changes ONLY the authenticated user's own vote
        (
          (resource.data.get('isPublic', false) == true || resource.data.get('isConfidential', false) == false) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'upvotedBy', 'updatedAt']) &&
          (
            // Upvote: Caller UID was not present, is now added, size +1, upvotes +1
            (
              !resource.data.upvotedBy.hasAny([request.auth.uid]) &&
              request.resource.data.upvotedBy.hasAny([request.auth.uid]) &&
              request.resource.data.upvotedBy.hasAll(resource.data.upvotedBy) &&
              request.resource.data.upvotedBy.size() == resource.data.upvotedBy.size() + 1 &&
              request.resource.data.upvotes == resource.data.upvotes + 1
            ) ||
            // Downvote (Undo): Caller UID was present, is now removed, size -1, upvotes -1
            (
              resource.data.upvotedBy.hasAny([request.auth.uid]) &&
              !request.resource.data.upvotedBy.hasAny([request.auth.uid]) &&
              resource.data.upvotedBy.hasAll(request.resource.data.upvotedBy) &&
              request.resource.data.upvotedBy.size() == resource.data.upvotedBy.size() - 1 &&
              request.resource.data.upvotes == resource.data.upvotes - 1
            )
          )
        )
      );

      allow delete: if isAdmin();
    }

    // ===============================================================
    // 4. ATTENDANCE SESSIONS
    // ===============================================================
    match /attendance_sessions/{sessionId} {
      allow read: if isAuthenticated();

      // SECURITY ENFORCEMENT: Students CANNOT write to attendance sessions from client.
      // Sessions are created and managed strictly by faculty/staff and admin.
      // Check-ins must be executed via trusted Cloud Function or faculty device.
      allow create, update, delete: if isStaff() || isAdmin();
    }

    // ===============================================================
    // 5. STUDENT ATTENDANCE RECORDS (Anti-Forgery Hardening)
    // ===============================================================
    match /student_attendance/{recordId} {
      // Students can only view their own verified attendance records; Staff/Admin can view all
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isStaff() ||
        resource.data.get('studentUid', '') == request.auth.uid ||
        resource.data.get('studentId', '') == request.auth.uid
      );

      // SECURITY ENFORCEMENT: Students CANNOT create or modify attendance records directly from client.
      // Official attendance records must be generated via trusted Cloud Functions (Admin SDK)
      // or recorded directly by authorized faculty/staff/admin.
      allow create, update: if isStaff() || isAdmin();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // 6. MASTER DATA (Categories & Departments)
    // ===============================================================
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ===============================================================
    // 7. NOTIFICATIONS COLLECTION
    // ===============================================================
    match /notifications/{notificationId} {
      // Read: Limited to intended recipient or admin
      allow read: if isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('recipientUid', '') == request.auth.uid ||
        (isStaff() && resource.data.get('userRole', '') == 'staff') ||
        isAdmin()
      );

      // Creation: Staff/Admin can notify; Students can ONLY notify 'admin' or themselves regarding their verified complaint
      allow create: if isAuthenticated() && (
        isAdmin() ||
        isStaff() ||
        isLegitimateStudentNotification()
      );

      // Update: Recipients can ONLY toggle 'isRead'
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          (resource.data.get('userId', '') == request.auth.uid || resource.data.get('recipientUid', '') == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt'])
        )
      );

      allow delete: if isAdmin();
    }
  }
}
